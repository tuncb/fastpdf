#include <windows.h>
#include "resource.h"
1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "FastPDF — native PDF reader\0"
   VALUE "ProductName", "FastPDF\0"
   VALUE "FileVersion", "0.1.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
IDD_PASSWORD DIALOGEX 0,0,260,100
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Open protected PDF"
FONT 10, "Segoe UI"
BEGIN
 LTEXT "Enter the document password.",IDC_PASSWORD_NOTE,12,12,236,14
 EDITTEXT IDC_PASSWORD,12,32,236,18,ES_PASSWORD | ES_AUTOHSCROLL
 DEFPUSHBUTTON "Open",IDOK,136,68,54,20
 PUSHBUTTON "Cancel",IDCANCEL,194,68,54,20
END
IDD_GOTO DIALOGEX 0,0,210,90
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Go to page"
FONT 10, "Segoe UI"
BEGIN
 LTEXT "Page number",-1,12,12,180,12
 EDITTEXT IDC_PAGE,12,30,186,18,ES_NUMBER | ES_AUTOHSCROLL
 DEFPUSHBUTTON "Go",IDOK,86,60,54,20
 PUSHBUTTON "Cancel",IDCANCEL,144,60,54,20
END
