#include <windows.h>
#include "resource.h"
#pragma code_page(65001)
IDI_APP ICON "assets/fastpdf.ico"
1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "FastPDF — native PDF reader\0"
   VALUE "ProductName", "FastPDF\0"
   VALUE "FileVersion", "0.2.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
IDD_FIND_BAR DIALOGEX 0,0,480,36
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 10, "Segoe UI"
BEGIN
 EDITTEXT IDC_FIND_TEXT,12,6,210,12,ES_AUTOHSCROLL
 LTEXT "",IDC_FIND_COUNT,226,6,48,12,SS_RIGHT | SS_CENTERIMAGE
 PUSHBUTTON "Previous",IDC_FIND_PREVIOUS,280,5,42,14
 PUSHBUTTON "Next",IDC_FIND_NEXT,326,5,32,14
 PUSHBUTTON "Results",IDC_FIND_RESULTS,362,5,40,14
 PUSHBUTTON "Options",IDC_FIND_OPTIONS,406,5,40,14
 PUSHBUTTON "Close",IDC_FIND_CLOSE,450,5,30,14
 LTEXT "Enter text to find.",IDC_FIND_STATUS,12,23,420,10,SS_LEFT | SS_CENTERIMAGE
 PUSHBUTTON "Stop",IDC_FIND_STOP,440,22,28,12
END
IDD_FIND_OPTIONS DIALOGEX 0,0,220,113
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Search Options"
FONT 10, "Segoe UI"
BEGIN
 CONTROL "Match &case",IDC_FIND_CASE,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,9,196,12
 CONTROL "Whole &words",IDC_FIND_WORDS,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,27,196,12
 LTEXT "Search &in",-1,12,47,196,12
 COMBOBOX IDC_FIND_SCOPE,12,63,196,64,CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
 DEFPUSHBUTTON "Apply",IDOK,108,93,50,14
 PUSHBUTTON "Cancel",IDCANCEL,164,93,44,14
END
IDD_PASSWORD DIALOGEX 0,0,220,71
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Open Protected PDF"
FONT 10, "Segoe UI"
BEGIN
 LTEXT "Enter the document password.",IDC_PASSWORD_NOTE,12,9,196,12
 EDITTEXT IDC_PASSWORD,12,25,196,12,ES_PASSWORD | ES_AUTOHSCROLL
 DEFPUSHBUTTON "Open",IDOK,108,51,50,14
 PUSHBUTTON "Cancel",IDCANCEL,164,51,44,14
END
IDD_GOTO DIALOGEX 0,0,220,71
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Go To Page"
FONT 10, "Segoe UI"
BEGIN
 LTEXT "Page number",-1,12,9,196,12
 EDITTEXT IDC_PAGE,12,25,60,12,ES_NUMBER | ES_AUTOHSCROLL
 DEFPUSHBUTTON "Go",IDOK,108,51,50,14
 PUSHBUTTON "Cancel",IDCANCEL,164,51,44,14
END
IDR_BUILD_METADATA RCDATA "release-manifest.json"
IDD_PRINT_PREVIEW DIALOGEX 0,0,230,200
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE
EXSTYLE WS_EX_CONTROLPARENT
FONT 10, "Segoe UI"
BEGIN
 LTEXT "Page Preview",IDC_PREVIEW_TITLE,12,9,206,12
 CONTROL "",IDC_PREVIEW_IMAGE,"Static",SS_OWNERDRAW,12,25,206,140
 PUSHBUTTON "&Previous",IDC_PREVIEW_PREVIOUS,12,180,50,14
 LTEXT "",IDC_PREVIEW_PAGE,68,180,94,14,SS_CENTER | SS_CENTERIMAGE
 PUSHBUTTON "&Next",IDC_PREVIEW_NEXT,168,180,50,14
END
IDR_FONT_LICENSE RCDATA "FONT-DATA-LICENSE.txt"
IDR_UNICODE_LICENSE RCDATA "UNICODE-LICENSE.txt"
IDD_LICENSES DIALOGEX 0,0,480,328
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "FastPDF — Third-Party Notices"
FONT 10, "Segoe UI"
BEGIN
 EDITTEXT IDC_LICENSES,12,12,456,284,ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
 DEFPUSHBUTTON "Close",IDOK,418,308,50,14
END
IDD_ABOUT DIALOGEX 0,0,220,69
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About FastPDF"
FONT 10, "Segoe UI"
BEGIN
 LTEXT "",IDC_ABOUT_VERSION,12,9,196,12
 CONTROL "<a href=""https://github.com/tuncb/fastpdf"">https://github.com/tuncb/fastpdf</a>",IDC_REPOSITORY,"SysLink",WS_TABSTOP,12,23,196,12
 PUSHBUTTON "&Third-party notices…",IDC_NOTICES,12,49,100,14
 DEFPUSHBUTTON "Close",IDOK,158,49,50,14
END
IDD_INSTALLATION DIALOGEX 0,0,220,95
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Install FastPDF"
FONT 10, "Segoe UI"
BEGIN
 LTEXT "Install folder:",-1,12,9,196,10
 LTEXT "",IDC_INSTALL_FOLDER,12,21,196,12,SS_NOPREFIX | SS_PATHELLIPSIS
 CONTROL "Create a Start &menu shortcut",IDC_INSTALL_SHORTCUT,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,37,196,12
 CONTROL "Use FastPDF as the default &PDF reader",IDC_INSTALL_PDF,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,51,196,12
 DEFPUSHBUTTON "Install",IDOK,108,75,50,14
 PUSHBUTTON "Cancel",IDCANCEL,164,75,44,14
 PUSHBUTTON "Uninstall",IDC_INSTALL_UNINSTALL,12,75,57,14
END

IDD_PROMPT DIALOGEX 0,0,260,90
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "FastPDF"
FONT 10, "Segoe UI"
BEGIN
 LTEXT "",IDC_PROMPT_TEXT,12,9,236,40,SS_NOPREFIX
 CONTROL "",IDC_PROMPT_CHECK,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,12,51,236,12
END
